# ──────────────────────────────────────────────────────────────
# Kasauti Production Configuration Template
# Copy this file to .env and fill in your real credentials.
# NEVER commit or share your real .env file!
# ──────────────────────────────────────────────────────────────

# ── Supabase Integration (PostgreSQL + Object Storage) ─────────
# Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=
# Service role secret key (bypasses RLS for backend ingestion & storage uploads)
SUPABASE_SERVICE_ROLE_KEY=
# Supabase storage bucket for audio recordings, degraded acoustic WAVs, and training datasets
SUPABASE_BUCKET_NAME=kasauti-audio-artifacts
# Direct pooled PostgreSQL connection string (asyncpg / SQLAlchemy)
# e.g. postgresql+asyncpg://postgres.xyz:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./kasauti.db

# ── Bolna Voice AI Telephony ───────────────────────────────────
# Set to "real" for live call evaluation and webhook delivery
BOLNA_MODE=mock
# Your Bolna API key (from dashboard.bolna.ai)
BOLNA_API_KEY=
BOLNA_BASE_URL=https://api.bolna.ai
# Whitelisted carrier webhook IPs for ingress validation
BOLNA_WEBHOOK_IPS=13.203.39.153,13.126.9.249,13.202.133.53

# ── Bolna Agent IDs ───────────────────────────────────────────
# Production target agent — STRICTLY IMMUTABLE (Kasauti will never alter this)
BOLNA_TARGET_AGENT_ID=
# Staging clone — isolated sandbox for autonomous AST prompt healing & retests
BOLNA_STAGING_AGENT_ID=
# Simulated persona agent that places the outbound call
BOLNA_CALLER_AGENT_ID=
# E.164 phone number assigned to target agent (+91XXXXXXXXXX)
BOLNA_TARGET_PHONE=
# Public HTTPS webhook URL for telephony events (e.g. https://api.kasauti.ai/webhooks/bolna)
PUBLIC_WEBHOOK_URL=
# Call direction: caller_to_target | target_to_caller
DIRECTION=caller_to_target

# ── Sarvam AI Integration (Indic Speech-to-Text & Translation) ──
# Set to "real" when Sarvam subscription key is active
SARVAM_MODE=mock
# Sarvam subscription key for Saarika v2 Indic STT
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
# Rate cap to conserve API usage
SARVAM_MAX_REQUESTS=25

# ── Anthropic LLM (Conversational Rubric Judge) ─────────────────
# Anthropic API Key for qualitative conversational evaluations
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── GitHub GitOps & PR Automation ──────────────────────────────
# Personal Access Token or GitHub App Token for autonomous PR creation
GITHUB_TOKEN=
# Target repository for prompt pull requests (e.g. your-org/voice-agent-prompts)
GITHUB_PROMPT_REPO=

# ── Budget Guard & Telephony Safety Caps ───────────────────────
# Hard dollar stop for API spend
BUDGET_USD=8.00
# Maximum concurrent calls per benchmark run
MAX_CALLS_PER_RUN=3
# Duration limit per call in seconds (prevents runaway calls)
MAX_CALL_SECONDS=60
DAILY_SPEND_CAP=8.00

# ── Server & Frontend Endpoints ────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
