# ──────────────────────────────────────────────────────────────
# Kasauti Configuration Template
# Copy this file to .env and fill in your real values.
# NEVER commit or share your real .env file!
# ──────────────────────────────────────────────────────────────

# ── Bolna Integration ──────────────────────────────────────────
# Set to "real" when ready to place live calls
BOLNA_MODE=mock
# Your Bolna API key (get from dashboard.bolna.ai)
BOLNA_API_KEY=
BOLNA_BASE_URL=https://api.bolna.ai
BOLNA_WEBHOOK_IPS=13.203.39.153,13.126.9.249,13.202.133.53

# ── Agent IDs (from Bolna Dashboard) ───────────────────────────
# Production target agent — NEVER auto-modified by Kasauti
BOLNA_TARGET_AGENT_ID=
# Staging clone — used for prompt fixes & retests
BOLNA_STAGING_AGENT_ID=
# Simulated persona agent that dials out (if caller_to_target)
BOLNA_CALLER_AGENT_ID=
# Phone number attached to target agent (E.164 format: +91XXXXXXXXXX)
BOLNA_TARGET_PHONE=
# Public webhook URL (e.g. https://xyz.ngrok-free.app/webhooks/bolna)
PUBLIC_WEBHOOK_URL=
# caller_to_target | target_to_caller
DIRECTION=caller_to_target

# ── Sarvam AI Integration ──────────────────────────────────────
# Set to "real" when you have credits
SARVAM_MODE=mock
# Your Sarvam subscription key
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
# Request counter limit to conserve free credits
SARVAM_MAX_REQUESTS=25

# ── Anthropic LLM (Optional, mock fallback available) ──────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./kasauti.db

# ── Budget Guard & Safety Caps ─────────────────────────────────
# Hard spend stop (buffer for $10 account)
BUDGET_USD=8.00
# Strict cap per run
MAX_CALLS_PER_RUN=3
# Persona duration ceiling per call (seconds)
MAX_CALL_SECONDS=60

# ── Server ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# ── Frontend ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
